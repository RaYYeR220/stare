{
  "name": "stare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:test": "sh scripts/db-test.sh",
    "test": "vitest run",
