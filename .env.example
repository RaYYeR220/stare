# FalkorDB (admin connection is used only for provisioning: UDF load, ACL users, GRAPH.COPY)
FALKORDB_URL=falkor://127.0.0.1:6390
FALKORDB_ADMIN_USER=default
FALKORDB_ADMIN_PASSWORD=
# Venice API (chat + embeddings)
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
STARE_CHAT_MODEL=z-ai-glm-5-3-flash
STARE_EMBED_MODEL=text-embedding-qwen3-0-6b
STARE_EMBED_DIM=512
# Signs demo/session tokens
STARE_TOKEN_SECRET=change-me
